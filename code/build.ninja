nvcc = nvcc
nvccflags = -std=c++17 -I spr/inc -Xcompiler="/EHsc /nologo"
builddir = build
bin_dir = build/bin

rule mkdir
  command = powershell -NoProfile -ExecutionPolicy Bypass -Command "New-Item -ItemType Directory -Force -Path '$out' | Out-Null"
  description = MKDIR $out

rule nvcc_exe
  command = $nvcc $nvccflags $in -o $out
  description = NVCC $out

rule run_experiment
  command = powershell -NoProfile -ExecutionPolicy Bypass -Command "New-Item -ItemType Directory -Force -Path '../working' | Out-Null; & './$in'; if ($$LASTEXITCODE -ne 0) { exit $$LASTEXITCODE }; New-Item -ItemType File -Force -Path '$out' | Out-Null"
  description = RUN $in

build build/bin: mkdir

build build/bin/body_shirt_clearance_experiment.exe: nvcc_exe body_shirt_clearance_experiment.cu spr/src/dbg.cu | build/bin
build build/bin/body_shirt_clearance_experiment.passed: run_experiment build/bin/body_shirt_clearance_experiment.exe

build build/bin/body_shirt_landmark_adsdf_experiment.exe: nvcc_exe body_shirt_landmark_adsdf_experiment.cu spr/src/dbg.cu | build/bin
build build/bin/body_shirt_landmark_adsdf_experiment.passed: run_experiment build/bin/body_shirt_landmark_adsdf_experiment.exe

build build/bin/tentacle_armature_adsdf_experiment.exe: nvcc_exe tentacle_armature_adsdf_experiment.cu spr/src/dbg.cu | build/bin
build build/bin/tentacle_armature_adsdf_experiment.passed: run_experiment build/bin/tentacle_armature_adsdf_experiment.exe

build body_shirt_clearance_experiment: phony build/bin/body_shirt_clearance_experiment.exe
build run_body_shirt_clearance_experiment: phony build/bin/body_shirt_clearance_experiment.passed

build body_shirt_landmark_adsdf_experiment: phony build/bin/body_shirt_landmark_adsdf_experiment.exe
build run_body_shirt_landmark_adsdf_experiment: phony build/bin/body_shirt_landmark_adsdf_experiment.passed

build tentacle_armature_adsdf_experiment: phony build/bin/tentacle_armature_adsdf_experiment.exe
build run_tentacle_armature_adsdf_experiment: phony build/bin/tentacle_armature_adsdf_experiment.passed

build experiments: phony build/bin/body_shirt_clearance_experiment.passed build/bin/body_shirt_landmark_adsdf_experiment.passed build/bin/tentacle_armature_adsdf_experiment.passed
default experiments
